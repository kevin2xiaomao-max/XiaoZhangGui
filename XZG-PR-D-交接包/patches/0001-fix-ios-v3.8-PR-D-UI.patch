-enum AppTypography {
-    static let pageTitle = Font.system(size: 30, weight: .semibold, design: .rounded)
-    static let sectionTitle = Font.system(size: 20, weight: .semibold, design: .rounded)
-    static let cardTitle = Font.system(size: 16, weight: .medium)
