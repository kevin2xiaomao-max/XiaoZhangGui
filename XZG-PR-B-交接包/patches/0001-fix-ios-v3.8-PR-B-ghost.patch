+    /// V3.8 P1-B2：图表合计行文案与周期口径一一对应（周 ≠ 近7日）。
+    var trendTotalLabel: String {
+        switch self {
+        case .day: return "近7日合计"
+        case .week: return "近4周合计"
+        case .month: return "近30日合计"
+        }
