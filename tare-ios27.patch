diff --git a/XiaoZhangGui/DesignSystem/V21Components.swift b/XiaoZhangGui/DesignSystem/V21Components.swift
index 3a4b0de..8ffcb1a 100644
--- a/XiaoZhangGui/DesignSystem/V21Components.swift
